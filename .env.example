# ==========================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG - ANTIGRAVITY MATH STUDIO
# ==========================================================

# Địa chỉ IP lắng nghe (0.0.0.0 để cho phép truy cập từ mạng ngoài/LAN/Docker)
HOST=0.0.0.0

# Cổng dịch vụ (Mặc định: 8080)
PORT=8080

# Tự động mở trình duyệt khi khởi động (true/false)
# Khi deploy trên VPS Linux hoặc Docker nên đặt false
SHOW_BROWSER=false

# Môi trường chạy (development / production)
ENV=production

# Đường dẫn file stylesheet MML2OMML.XSL (Tùy chọn, nếu muốn Native Word Equation trên Linux)
# MML2OMML_PATH=/app/assets/MML2OMML.XSL
